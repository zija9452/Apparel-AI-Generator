# SECRETS. The keys reach the container through Cloud Run's environment, never
# through the image - an image can be pulled by anyone with registry access,
# and layers keep what you later delete.
.env
.env.*

# Runtime state and job output. apparel_sessions.db alone reached 1.1GB.
*.db
*.db-wal
*.db-shm
uploads/
Production testing files/

