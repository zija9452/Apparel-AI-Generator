# Copy to .env.local for development; set the same names in Vercel for production.

# ---------------------------------------------------------------------------
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, and that is the whole point: anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript the browser downloads
# and is readable in DevTools. These two are read only inside
# app/api/plan/route.ts, which runs on the server.
# ---------------------------------------------------------------------------

# The planning half - Excel in, plan out. Cloud Run in production.
# Leave it on localhost while the local backend is still playing that role.
CLOUD_API=http://localhost:8000

# Must match CLOUD_API_KEY in the backend's environment. Leave EMPTY for local
# development, where the backend runs without a key.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# PUBLIC, deliberately. This one reaches the browser, and must - it is the
# address the browser itself dials. It is not a secret: it is localhost.
# ---------------------------------------------------------------------------

# The rendering half, on the machine the browser is running on. This is
# localhost BY DEFINITION - it is not a server you deploy, it is the designer's
# own PC. Only change the port if the agent was configured to use another one.
NEXT_PUBLIC_AGENT_URL=http://localhost:8765
